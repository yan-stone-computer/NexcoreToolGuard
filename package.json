{
  "name": "nexcore-tool-guard",
  "version": "0.1.0",
  "description": "Risk-aware tool-call guard with content-bound approvals, call budgets, argument redaction and circuit breaking.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-force-exit test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": ["ai-agent", "tool-calling", "human-in-the-loop", "approval", "security", "circuit-breaker"],
  "license": "MIT",
  "engines": {"node": ">=22.13.0"},
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
